ard.dataset.ref=d[0].replace(/^0\d　/,'');card.querySelector('h3').textContent=d[0];card.querySelector('p').textContent=d[1];card.querySelector('.finding-facts').innerHTML=d.slice(2).map(v=>{const [n,l]=v.split('｜');return `<span><b>${n}</b>${l}</span>`}).join('')});});
