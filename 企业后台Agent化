<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Frontis · 企业 AI 使用日报</title>
  <style>
    :root{--ink:#273d46;--deep:#234f65;--teal:#2e7f77;--mint:#eaf4ef;--line:#e7e5dc;--muted:#71828d;--paper:#f6f4ee;--letter:#fffdf8;font-family:Inter,-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft Yahei",Arial,Helvetica,sans-serif}
    .agent-switcher{display:flex;gap:9px;margin:0 0 22px}.agent-switch{display:flex;align-items:center;gap:8px;padding:8px 11px;border:1px solid #e2e3dc;border-radius:9px;color:#6f7f80;background:#fff}
    .report-actions{position:relative;display:flex;align-items:center;gap:8px}.history-toggle{margin-top:4px;padding:7px 9px;border:1px solid #e2ebeb;border-radius:7px;color:#70838b;background:#fff}
    .page{max-width:790px;margin:0 auto;padding:46px 0 158px}.report{border-color:#e1ded1!important;border-radius:3px!important;background:var(--letter)!important;box-shadow:0 12px 33px rgba(74,68,47,0.08)}
    body{padding-left:230px}.side-nav{position:fixed;z-index:10;top:0;bottom:0;left:0;width:230px;padding:24px 14px;border-right:1px solid #e1e3df;background:#fffdf8}.side-brand{display:flex;align-items:center;gap:10px}
  </style>
</head>
<body>
  <aside class="side-nav"><div class="side-brand"><i>F</i><span>Frontis 企业管理</span></div><nav class="side-menu"><button class="side-item group active"><i>✦</i>AI 组织专家团</button></nav></aside>
  <header class="top"><div class="brand"><span class="logo">F</span>Frontis <span class="tenant">北辰科技 · 企业 AI 管理中心</span></div><div class="profile"><i>求</i><span>求索</span></div></header>
  <main class="page">
    <nav class="agent-switcher"><button class="agent-switch" data-agent="manager"><i>管</i><span><b>平台管理助手</b>治理与配置</span></button><button class="agent-switch active" data-agent="analytics"><i>析</i><span><b>AI 运营分析师</b>使用观察</span></button></nav>
    <section class="thread-line"><span class="message-avatar">析</span><div class="message-meta"><b>AI 运营分析师</b><span id="messageTime">今天 10:20</span></div><article class="report"><h2>报告</h2>
      <button class="finding" data-ref="销售部复用人数下降"><div class="finding-top"><h3>01　销售部复用人数下降</h3><time>最近 7 天</time></div><p>复用人数从 19 人降至 12 人</p></button>
      <button class="finding" data-ref="客户方案助手知识库将在 7 天后过期"><div class="finding-top"><h3>02　常用知识库将在 7 天后过期</h3><time>刚刚</time></div><p>客户方案知识库将在 7 天后过期</p></button>
      <div class="section-label">今天的使用概览</div><div class="overview"><div class="metric"><span>已激活成员</span><b>34 <em>/ 40 人</em></b></div></div>
      <article class="user-message" id="userMessage" style="display:none"><span class="user-avatar">李</span><div class="user-bubble" id="userText"></div></article>
      <article class="agent-followup" id="agentFollowup" style="display:none"><span class="agent-avatar">A</span><div class="agent-bubble" id="agentText"></div></article>
    </article>
    </section>
  </main>
  <div class="composer-area"><div class="composer-inner"><div class="quote" id="quote" style="display:none"><span>引用来信：<b id="quoteText"></b></span><button id="clearQuote" aria-label="取消引用">×</button></div>
    <form id="composer">
      <input id="input" placeholder="说点什么..." />
      <button type="submit">发送</button>
    </form>
  </div></div>
  <script>
    // Safer JS: wait until DOM is ready and guard element access to avoid TypeError that breaks the page
    document.addEventListener('DOMContentLoaded', function () {
      const $ = id => document.getElementById(id);
      let reference = '';

      function setReference(text){
        reference = text;
        try{
          document.querySelectorAll('.finding').forEach(x=>x.classList.toggle('selected', x.dataset && x.dataset.ref === text));
          const qt = $('quoteText'); if(qt) qt.textContent = text;
          const q = $('quote'); if(q) q.style.display = text ? 'block' : 'none';
        }catch(e){console.warn('setReference error', e)}
      }

      // Attach click handlers to .finding buttons (if any)
      const findings = document.querySelectorAll('.finding');
      findings.forEach(x=>x.addEventListener('click', ()=>{ if(x.dataset && x.dataset.ref) setReference(x.dataset.ref); }));

      const clearBtn = $('clearQuote'); if(clearBtn){ clearBtn.addEventListener('click', ()=>{ reference=''; const q=$('quote'); if(q) q.style.display='none'; document.querySelectorAll('.finding').forEach(x=>x.classList.remove('selected')); const inp = $('input'); if(inp) inp.focus(); }); }

      const historyToggle = $('historyToggle'); if(historyToggle){ historyToggle.addEventListener('click', ()=>{ const hm = $('historyMenu'); if(hm) hm.classList.toggle('open'); }); }

      // Composer submit (打卡/发送) — persist to localStorage as a simple demo so "打卡" works on static pages
      const composer = $('composer');
      if(composer){
        composer.addEventListener('submit', function(e){
          e.preventDefault();
          const input = $('input');
          if(!input) return;
          const text = input.value.trim();
          if(!text) return;

          // show user message
          const userText = $('userText'); const userMsg = $('userMessage');
          if(userText) userText.textContent = text;
          if(userMsg) userMsg.style.display = 'block';

          // simple "打卡" storage in localStorage so it persists on GitHub Pages
          try{
            const key = 'frontis_checkin_history';
            const prev = JSON.parse(localStorage.getItem(key) || '[]');
            prev.push({text, time: new Date().toISOString(), reference});
            localStorage.setItem(key, JSON.stringify(prev));
          }catch(err){ console.warn('localStorage not available', err); }

          // simulate agent reply
          const agentText = $('agentText'); const agentFollow = $('agentFollowup');
          if(agentText) agentText.innerHTML = '<em>已记录：' + (new Date()).toLocaleString() + '</em>';
          if(agentFollow) agentFollow.style.display = 'block';

          // clear input
          input.value = '';
        });
      }

      // small UX safety: set default texts if missing
      const eyebrow = document.querySelector('.eyebrow'); if(eyebrow) eyebrow.textContent = '给求索的一封使用观察';
      const reportH2 = document.querySelector('.report h2'); if(reportH2) reportH2.textContent = '求索，早上好。';

    });
  </script>
</body>
</html>
